# Copy to .env and fill in. Never commit .env.
NEXUS_API_KEY=
# OpenAI-compatible base URL of the Nexus gateway (confirm from Nexus docs)
NEXUS_BASE_URL=https://REPLACE-WITH-NEXUS-ENDPOINT/v1
# Exact model names from the Nexus model list
NEXUS_LLM_MODEL=REPLACE_MODEL_A
NEXUS_LLM_MODEL_B=REPLACE_MODEL_B
NEXUS_VISION_MODEL=REPLACE_VISION_MODEL
NEXUS_STT_MODEL=REPLACE_STT_MODEL
NEXUS_TTS_MODEL=REPLACE_TTS_MODEL
NEXUS_TTS_VOICE=alloy
# 1 = send response_format=json_object (turn off if Nexus rejects it)
NEXUS_JSON_MODE=1
NEXUS_TIMEOUT=60
# 1 = use the offline mock instead of Nexus (also used automatically when no key is set)
NEXUS_MOCK=0
# Frontend -> backend
BACKEND_URL=http://127.0.0.1:8000
